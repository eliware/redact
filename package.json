{
  "name": "@eliware/redact",
  "version": "6.0.0",
  "description": "Reusable secret redaction and safe serialization utilities for Node.js projects",
  "author": "Eliware",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "docs",
    "examples",
    "specs",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "typecheck": "tsc --noEmit",
    "pack": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/redact"
  },
  "keywords": [
    "eliware",
    "redaction",
    "secrets",
    "serialization"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/eliware/redact/issues"
  },
  "homepage": "https://github.com/eliware/redact#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eliware/test": "^6.0.0",
    "typescript": "^7.0.2"
  }
}
