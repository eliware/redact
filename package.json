{
  "name": "@eliware/redact",
  "version": "9.0.0",
  "private": false,
  "description": "Reusable secret-redaction and safe-serialization utilities for Node.js 26+.",
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "docs",
    "examples",
    "specs",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "typecheck": "tsc --noEmit",
    "audit": "eliware-test --audit",
    "pack": "eliware-test --pack",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/redact.git"
  },
  "keywords": [
    "eliware",
    "redaction",
    "secrets",
    "serialization"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/eliware/redact/issues"
  },
  "homepage": "https://github.com/eliware/redact#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devDependencies": {
    "@eliware/test": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "eliware": {
    "apply": [
      "general",
      "library",
      "npm-published"
    ],
    "exempt": [],
    "capabilities": [
      "typecheck"
    ]
  }
}
