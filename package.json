{
  "name": "@eliware/redact",
  "version": "8.0.0",
  "description": "Reusable secret-redaction and safe-serialization utilities for Node.js 26+.",
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "docs",
    "examples",
    "specs",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "typecheck": "tsc --noEmit",
    "pack": "npm pack --dry-run",
    "audit": "npm audit --ignore-scripts --omit=dev --audit-level=moderate",
    "format": "prettier --write src tests typecheck examples README.md AGENTS.md RELEASE_NOTES.md docs specs *.md",
    "format:check": "prettier --check src tests typecheck examples README.md AGENTS.md RELEASE_NOTES.md docs specs *.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/redact"
  },
  "keywords": [
    "eliware",
    "redaction",
    "secrets",
    "serialization"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/eliware/redact/issues"
  },
  "homepage": "https://github.com/eliware/redact#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eliware/test": "file:../test",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "eliware": {
    "conventions": {
      "version": "8.0",
      "apply": [
        "general",
        "node",
        "library",
        "npm-published"
      ],
      "exemptions": []
    },
    "authority": {
      "authoritativeFor": [
        "Redaction and safe-serialization library behavior."
      ],
      "notAuthoritativeFor": [
        "Shared platform conventions, operations, publication, or deployment."
      ]
    },
    "crosslinks": [
      {
        "path": "specs/README.md",
        "relation": "relatedAuthority",
        "authoritativeFor": "Project-specific behavior specifications."
      }
    ]
  }
}
